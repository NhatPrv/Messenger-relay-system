# Server Settings
PORT=5000
NODE_ENV=development

# Security Settings
# Local password used to login to the Web Client Dashboard
ADMIN_PASSWORD=change_this_secure_password_123
# JWT Secret for dashboard session tokens
JWT_SECRET=super_secret_session_key_change_me

# Facebook Settings
# Set to true to bypass Facebook login and generate mock data for testing
FB_MOCK_MODE=true
# Path to appstate.json containing exported Facebook session cookies
FB_APPSTATE_PATH=./appstate.json
